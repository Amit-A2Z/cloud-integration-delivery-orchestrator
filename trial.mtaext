# CE/trial landscape: BTP trial 0a93a4fbtrial, us10-001, org 0a93a4fbtrial, space dev.
#   mbt build
#   CF_HOME=~/.cf-trial cf deploy mta_archives/cloud-integration-delivery-orchestrator_1.0.0.mtar -e trial.mtaext

_schema-version: "3.1.0"
ID: cloud-integration-delivery-orchestrator-trial
extends: cloud-integration-delivery-orchestrator

parameters:
  app-host-prefix: "cido-0a93a4fb"
  # 0.0.5 = latest on 2026-10-29 (digest sha256:670d1d9d4efa...). Pinned for the demo.
  docker-image: "ghcr.io/sap/cloud-integration-delivery-orchestrator:0.0.5"
  # The trial marketplace offers postgresql-db plan "trial" only (no "development").
  db-service-plan: "trial"

# Local runs (arm64 container on the Mac, bound to these services) log in through the same XSUAA
# client, so allow localhost callbacks too. Trial only: this list replaces the one in mta.yaml.
resources:
  - name: cloud-integration-delivery-orchestrator-uaa
    parameters:
      config:
        oauth2-configuration:
          redirect-uris:
            - "https://${app-host-prefix}.${default-domain}/**"
            - "http://localhost:8080/**"
            - "http://127.0.0.1:8080/**"

  # SAP Alert Notification: the trial offers plan "standard" only (mta.yaml uses "free").
  # CIDO publishes delivery.approval.requested and delivery.status.<status> events
  # (pkg/notify/composite.go). One condition + one EMAIL action + one subscription mail them.
  # A new EMAIL action stays inactive until the recipient confirms the ANS confirmation mail.
  - name: cloud-integration-delivery-orchestrator-ans
    active: true
    parameters:
      service-plan: standard
      config:
        configuration:
          conditions:
            - name: cido-delivery-events
              description: All CIDO delivery events
              propertyKey: eventType
              predicate: STARTS_WITH
              propertyValue: "delivery."
          actions:
            - name: cido-mail-amit
              description: Mail CIDO delivery events
              type: EMAIL
              state: ENABLED
              properties:
                destination: amit.shukla@mindsetconsulting.com
          subscriptions:
            - name: cido-delivery-to-mail
              state: ENABLED
              conditions: [cido-delivery-events]
              actions: [cido-mail-amit]
